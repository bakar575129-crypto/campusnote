# Kalemlik yapılandırması — bu dosyayı ".env" adıyla kopyalayıp düzenleyin.
# .env dosyası uygulama klasöründe durur; asla public_html içine koymayın, asla paylaşmayın.

NODE_ENV=production
# Sitenin tam adresi (alt klasör olmadan). Canlıda https:// zorunludur.
APP_URL=https://not.ornekuniversite.com
# cPanel/Passenger kendi portunu verir; yerelde 3000 kullanılır.
PORT=3000
# Uygulama bir vekil sunucunun (cPanel/Apache/Nginx) arkasındaysa 1 bırakın.
TRUST_PROXY=1

# ---- Veritabanı (MySQL 8+ / MariaDB 10.6+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_kalemlik
DB_USER=cpaneluser_kalemlik
DB_PASSWORD=
DB_POOL_SIZE=6
# Yalnızca barındırma sağlayıcınız Unix soketi istiyorsa doldurun.
DB_SOCKET=

# ---- Dosyalar
# Kullanıcı dosyalarının (PDF sayfaları, stickerlar, yazı tipleri) klasörü. dist/ dışında olmalı.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# ---- Hesaplar
# true: herkes kayıt olabilir; false: yalnızca mevcut hesaplar giriş yapar. İlk kayıt olan hesap yönetici olur.
REGISTRATION_OPEN=true
SESSION_DAYS=30

# ---- El yazısını metne çevirme (isteğe bağlı)
# Anahtar olmadan tanıma cihazda (tarayıcıda) çalışır. Anahtar eklenirse önce sunucu denenir.
# Anahtar Yönetim → Sistem ekranından da girilebilir (yeniden başlatma gerekmez). Anahtarlar tarayıcıya gönderilmez.
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4.1-mini

# ---- E-posta (şifre sıfırlama bağlantıları için, isteğe bağlı)
# Boş bırakılırsa bağlantı sunucu günlüğüne yazılır; yönetici "npm run password:reset" de kullanabilir.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kalemlik <no-reply@ornekuniversite.com>"

# ---- Ödeme (isteğe bağlı; bkz. docs/ODEME.md)
# Boşken çevrimiçi satın alma kapalıdır; planlar "npm run plan:grant" ile atanır.
BILLING_PROVIDER=
BILLING_SUPPORT_EMAIL=
